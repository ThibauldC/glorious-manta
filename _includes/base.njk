<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#f4f2ed" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#101615" media="(prefers-color-scheme: dark)">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a class="skip-link" href="#content">Skip to content</a>
  <div class="site-shell">
    <header class="site-header">
      <a class="brand" href="/" aria-label="{{ site.title }}, home">
        <span class="brand-mark" aria-hidden="true">TC</span>
        <span><strong>Thibauld</strong><small>Data notes</small></span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/posts/">Posts</a>
        <a href="/presentations/">Presentations</a>
        <a href="/biography/">Biography</a>
      </nav>
    </header>

    <main id="content">{{ content | safe }}</main>

    <footer class="site-footer">
      <div><strong>{{ site.author }}</strong><p>I build data platforms and share what holds up in production.</p></div>
      <div class="footer-links">
        <a href="{{ site.github }}">GitHub</a>
        <a href="{{ site.linkedin }}">LinkedIn</a>
        <a href="{{ site.sessionize }}">Sessionize</a>
      </div>
      <small>© {{ currentYear }} · This site uses Markdown and publishes static HTML.</small>
    </footer>
  </div>

  <script type="module">
    if (document.querySelector('.mermaid')) {
      const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11.17.0/dist/mermaid.esm.min.mjs');
      mermaid.initialize({ startOnLoad: true, theme: matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'neutral' });
    }
  </script>
</body>
</html>
