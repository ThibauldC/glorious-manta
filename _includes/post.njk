---
layout: base.njk
---
<article class="article">
  <header class="article-header">
    <a class="back-link" href="/posts/">← All posts</a>
    <div class="eyebrow">{% if categories %}{{ categories[0] }}{% else %}Post{% endif %}</div>
    <h1>{{ title }}</h1>
    <div class="article-byline">
      <time datetime="{{ date | htmlDate }}">{{ date | readableDate }}</time><span aria-hidden="true">·</span><span>{{ site.author }}</span>
    </div>
    <div class="post-meta">{% for tag in tags %}<a class="tag tag-{{ tag | slug }}" href="/tags/#{{ tag | slug }}">{{ tag }}</a>{% endfor %}</div>
  </header>
  <div class="prose">{{ content | safe }}</div>
  <footer class="article-footer">
    <p>Questions or comments?</p>
    <a href="{{ site.linkedin }}">Discuss it on LinkedIn <span aria-hidden="true">↗</span></a>
  </footer>
</article>
