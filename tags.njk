---
layout: base.njk
title: Tags
permalink: /tags/index.html
description: Browse posts by topic.
---
<header class="page-header compact"><div class="eyebrow">All tags</div><h1>Topics</h1><p>Find related posts by topic.</p></header>
<div class="tag-cloud">
{% for tag in collections.posts | allTags %}<a href="#{{ tag | slug }}">{{ tag }}</a>{% endfor %}
</div>
<div class="tag-sections">
{% for tag in collections.posts | allTags %}
  <section id="{{ tag | slug }}" class="tag-section">
    <h2>{{ tag }}</h2>
    <ul>{% for post in collections.posts %}{% if tag in post.data.tags %}<li><a href="{{ post.url }}">{{ post.data.title }}</a><time datetime="{{ post.date | htmlDate }}">{{ post.date | readableDate }}</time></li>{% endif %}{% endfor %}</ul>
  </section>
{% endfor %}
</div>
